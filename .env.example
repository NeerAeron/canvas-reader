# Canvas Reader credentials. Keep the real file OUTSIDE this folder:
#   mkdir -p ~/.config/canvas-reader
#   cp .env.example ~/.config/canvas-reader/canvas.env
#   chmod 600 ~/.config/canvas-reader/canvas.env
# Canvas Reader reads that location automatically. A file anywhere else must
# be passed with --env-file or CANVAS_ENV_FILE. A .env file in this folder is
# never read. Never put a real token in this example, a ZIP, or a chat.

# Your school's Canvas address (with or without /api/v1).
CANVAS_API_URL=https://your-school.instructure.com
# Canvas > Account > Settings > New access token. Leave blank to use a token
# saved with: python3 scripts/versions.py token store
CANVAS_API_TOKEN=
# IANA time zone for due dates, such as America/New_York or Europe/London.
# Optional; the default is America/Los_Angeles.
TIMEZONE=America/Los_Angeles
